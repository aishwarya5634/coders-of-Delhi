import json


#this is a function to load the data
def load_data(filename):
    with open(filename, "r") as f:
        data = json.load(f)
    return data


data = load_data("data.json")


data


type(data)


#this is a function that displays users and their connections 

def display_users(data):
    print("users and theur connections\n")
    for user in data['users']:
        print(f"{user['id']} - {user['name']} is friends with : {user['friends']} and liked pages are {user['liked_pages']} ")
    print("\npages information\n")
    for page in data['pages']:
        print(f"{page['id']} : {page['name']}")

display_users(data)
    
    



